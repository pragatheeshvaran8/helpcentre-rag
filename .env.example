# Copy to .env and fill in.
# Only generation needs a key. Ingest and search-only evaluation run fully
# offline on the local embedding model.

OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.0
MAX_TOKENS=900

# Held constant across both chunking strategies. Do not change this in the same
# run as a chunker change.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
